# Copy this file to .env and fill in optional keys as needed.
# Never commit your .env file to GitHub.

# Macro Dashboard (Free key from https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# Optional AI Daily Market Summary (leave blank to use built-in free VADER/NLP summary)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional Alert Delivery (Telegram Bot / Email SMTP)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Optional Real-Time Indian Broker APIs (Zerodha Kite / Upstox v2 / Angel One SmartAPI)
ZERODHA_API_KEY=
ZERODHA_ACCESS_TOKEN=
UPSTOX_ACCESS_TOKEN=
ANGEL_API_KEY=
ANGEL_ACCESS_TOKEN=
ANGEL_CLIENT_LOCAL_IP=127.0.0.1
ANGEL_CLIENT_PUBLIC_IP=127.0.0.1
ANGEL_MAC_ADDRESS=00:00:00:00:00:00
